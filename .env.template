# Environment variables template (NO REAL KEYS)
NOTION_API_KEY=your_notion_integration_secret_here
NOTION_DATABASE_ID=your_notion_database_id_here

# MODEL ADVANTAGE (EDGE) MATHEMATICAL CALIBRATION CONSTANTS
EFFICIENCY_SCALING_FACTOR=0.2833
TACTICAL_SCALING_FACTOR=0.2125
NO_TRADE_BASE_EXPONENT=1.54

# Target R:R (reward/risk) used to derive the structural entry price from
# edge_validation_price (TP) and structural_invalidation (SL). See
# core/math_engine.py:calculate_structural_entry.
STRUCTURAL_TARGET_RR=2.2

# Ruta local de la carpeta de Downloads, específica de cada desarrollador — usada por
# auto_fetch_tradingview_screenshot (cli/main.py) para localizar screenshots de TradingView.
# Ejemplo Linux/WSL: /home/tu_usuario/Downloads
# Ejemplo Windows vía WSL: /mnt/c/Users/tu_usuario/Downloads
TRADINGVIEW_DOWNLOADS_DIR=/path/to/your/Downloads

# P2_systematic (tools/p2_backtest.py) — directorio con los CSV de OHLC
# exportados por el script MT5 del lado Windows, uno por temporalidad
# ({P2_SYSTEMATIC_OHLC_DIR}/1W.csv, 1D.csv, 12H.csv, 4H.csv, 1H.csv;
# columnas mínimas: time, open, high, low, close). Mecanismo resuelto:
# WSL2 corre sobre el mismo equipo físico que MT5, acceso directo vía
# /mnt/c/, sin transferencia de red.
# Ejemplo: /mnt/c/Users/tu_usuario/MT5Exports/XAUUSD
P2_SYSTEMATIC_OHLC_DIR=/mnt/c/path/to/your/mt5_ohlc_exports

# BACKUP 3-2-1 (tools/backup.py) — snapshots diarios de las 3 DBs de cuenta +
# flight_sessions.json. Ver tools/backup.py para el detalle de cada medio.

# Ruta de montaje del USB destinado al backup (Medio 2). Debe existir y ser
# escribible en el momento en que corre el cron; si no lo es, tools/backup.py
# reporta ese medio como fallido pero continúa con B2 (Medio 3).
USB_BACKUP_PATH=/mnt/usb_backup

# Credenciales de la Application Key de Backblaze B2 usada para subir a
# Medio 3 (Object Lock, modo Governance, retención 30 días). Crear una
# Application Key con acceso restringido solo al bucket de backup, sin la
# capability bypassGovernance (ver tools/backup.py y tests/test_backup.py
# para el porqué).
B2_KEY_ID=your_b2_key_id_here
B2_APP_KEY=your_b2_application_key_here

# Nombre del bucket B2 (ya provisionado y configurado con Object Lock /
# versioning habilitado -- ver tools/backup.py).
B2_BUCKET_NAME=your_b2_bucket_name_here

# AUTO-RESOLUCIÓN CON VELAS (spec 002, config/auto_resolution.py) — banco de
# velas, export automático desde MT5 y sus reglas de negocio (horizontes,
# tolerancias) van fijas en el código, versionadas; acá solo lo que cambia de
# una máquina a otra. Todas las rutas de abajo se resuelven a absolutas
# (config/auto_resolution.py); si las dejás vacías, cada una usa un default
# anclado a este repo salvo donde se indica lo contrario.

# Carpeta con las DBs de cuenta y el resto de .data/. Default: <repo>/.data
# ACCOUNTS_DATA_DIR=/path/to/your/repo/.data

# Banco de velas nuevo (spec 002). Default: {ACCOUNTS_DATA_DIR}/candle_bank
# CANDLE_BANK_DIR=/path/to/your/repo/.data/candle_bank

# Carpeta WSL (bajo /mnt/c/) donde el exportador de Windows deja cada corrida,
# en un directorio nuevo por run_id. Sin valor real por defecto -- ejemplo:
# MT5_INCOMING_DIR=/mnt/c/Users/tu_usuario/MT5Exports/_incoming

# CSV que ya existían antes de la spec 002 ({LEGACY_EXPORTS_DIR}/{SIMBOLO}/{TF}.csv),
# los que lee el cuaderno; `candles import-legacy` los lee UNA vez para poblar el banco
# y nunca los modifica. Default: la carpeta que contiene a MT5_INCOMING_DIR.
# LEGACY_EXPORTS_DIR=/mnt/c/Users/tu_usuario/MT5Exports

# Python de Windows con el paquete MetaTrader5 instalado, y la ruta del
# exportador tal como la ve ESE Python (ruta estilo Windows, no WSL). Los fija
# el spike de interoperabilidad (plan.md §7, T22); sin ellos, el export queda
# manual, nunca bloquea.
# WINDOWS_PYTHON=C:\Users\tu_usuario\AppData\Local\Programs\Python\Python312\python.exe
# EXPORTER_WIN_PATH=C:\Users\tu_usuario\...\windows_export\export_p2_ohlc.py

# Activa el export automático (4 disparadores: al guardar, al abrir un audit,
# antes del reporte/backfill, al abrir el CLI). Apagado por defecto hasta que
# el spike de arriba lo confirme -- ver N31.
# AUTO_EXPORT=false

# Calendario de horario de verano del servidor del broker: us, eu o none.
# Candidato [NO VERIFICADO], lo fija el mismo spike. Default: us
# BROKER_DST_RULE=us
